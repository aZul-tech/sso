# /etc/nginx/sites-available/azultech-sso.conf
# TLS termination + reverse proxy for Keycloak and Lunchify.
# Get certs first:  certbot --nginx -d sso.azultech.rw -d lunch.azultech.rw

# ---------- Keycloak ----------
server {
    listen 80;
    server_name sso.azultech.rw;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name sso.azultech.rw;

    ssl_certificate     /etc/letsencrypt/live/sso.azultech.rw/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sso.azultech.rw/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;
    }
}

# ---------- Lunchify ----------
server {
    listen 80;
    server_name lunch.azultech.rw;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name lunch.azultech.rw;

    ssl_certificate     /etc/letsencrypt/live/lunch.azultech.rw/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lunch.azultech.rw/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
