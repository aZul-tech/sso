# ============================================================
#  Azul Tech SSO — environment template
#  Copy to .env and fill in real values. .env is git-ignored.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me-strong-random          # prod: openssl rand -hex 24

# --- Keycloak runtime ---
# LOCAL / DEV values (docker-compose.yml, `start-dev`):
KC_HOSTNAME_URL=http://localhost:8081
KC_HOSTNAME_ADMIN_URL=http://localhost:8081
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_PORT=8081
KC_LOG_LEVEL=INFO
#
# PRODUCTION values (also add docker-compose.prod.yml — see docs/HANDOFF-TO-IT.md):
#   KC_HOSTNAME_URL=https://sso.<company-domain>
#   KC_HOSTNAME_ADMIN_URL=https://sso.<company-domain>
#   KC_HOSTNAME_STRICT=true
#   KC_HOSTNAME_STRICT_HTTPS=true

# --- Keycloak admin ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-strong-random     # prod: openssl rand -hex 24

# --- Realm ---
KC_REALM=azul-tech

# --- Company identity ---
# ⚠️ DECIDE WITH IT: the email domain(s) allowed to sign in. Comma-separated.
# Everything keys off this — the domain guard, and which Zoho accounts get in.
ALLOWED_EMAIL_DOMAINS=azultech.rw

# --- Lunchify (the app that uses this SSO) ---
# DEV:
LUNCHIFY_ORIGIN=http://localhost:5173
LUNCHIFY_REDIRECT=http://localhost:5173/*
# PROD: LUNCHIFY_ORIGIN=https://lunch.<company-domain>
#       LUNCHIFY_REDIRECT=https://lunch.<company-domain>/*

# --- Zoho (upstream OIDC identity provider) ---
# From the Zoho API Console (https://api-console.zoho.com/). ROTATE the secret
# before go-live if it has ever been shared in plaintext.
ZOHO_ACCOUNTS_HOST=accounts.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
