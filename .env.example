# ============================================================
#  Azul Tech SSO — environment template
#  Copy to .env and fill in real values. .env is git-ignored.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me-strong-random          # prod: openssl rand -hex 24

# --- Keycloak runtime ---
# LOCAL / DEV values (docker-compose.yml, `start-dev`):
KC_HOSTNAME_URL=http://localhost:8081
KC_HOSTNAME_ADMIN_URL=http://localhost:8081
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_PORT=8081
KC_LOG_LEVEL=INFO
#
# PRODUCTION values (also add docker-compose.prod.yml — see docs/HANDOFF-TO-IT.md):
#   KC_HOSTNAME_URL=https://sso.<company-domain>
#   KC_HOSTNAME_ADMIN_URL=https://sso.<company-domain>
#   KC_HOSTNAME_STRICT=true
#   KC_HOSTNAME_STRICT_HTTPS=true

# --- Keycloak admin ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-strong-random     # prod: openssl rand -hex 24

# --- Realm ---
# Permanent once live — baked into the issuer URL and every client config.
KC_REALM=azultech

# --- Platform admins ---
# Comma-separated emails of named /Platform-Admins accounts (Keycloak operators,
# separate from any app's own admin role — see docs/PHASE-1-REALM.md).
PLATFORM_ADMIN_EMAILS=

# --- Lunchify (the app that uses this SSO) ---
# DEV:
LUNCHIFY_ORIGIN=http://localhost:5173
LUNCHIFY_REDIRECT=http://localhost:5173/*
LUNCHIFY_REDIRECT_BASE=http://localhost:5173/
# PROD: LUNCHIFY_ORIGIN=https://lunch.<company-domain>
#       LUNCHIFY_REDIRECT=https://lunch.<company-domain>/*
#       LUNCHIFY_REDIRECT_BASE=https://lunch.<company-domain>/

# --- SMTP (onboarding / no-password-provisioning emails) ---
# Keycloak's execute-actions-email uses this to send each new user their
# one-time set-your-own-password + MFA-enrolment link. Dev: MailHog
# (no auth, no TLS). Prod: real SMTP credentials — decision for IT.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=sso@azultech.rw
SMTP_FROM_NAME="Azul SSO"                           # sender name staff see in their inbox
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=false
SMTP_AUTH=false
# How long a provisioning email's one-time link stays valid, in seconds.
ONBOARDING_LINK_LIFESPAN_SECONDS=259200

# --- Company identity ---
# Consumed by the *app* (e.g. Lunchify's server/.env → ALLOWED_EMAIL_DOMAIN),
# not by this realm config — Keycloak itself doesn't gate signup by domain
# (accounts are provisioned explicitly via provision-users.sh, not self-service).
ALLOWED_EMAIL_DOMAIN=azultech.rw

# --- Zoho ---
# Not used in Phase 1. Zoho becomes a downstream SAML app of this realm in
# Phase 2 (see docs/PHASE-1-REALM.md) — nothing to configure here yet.
